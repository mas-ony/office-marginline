{
  "name": "@marginline/relay",
  "version": "0.2.0",
  "description": "Real-time collaboration relay for Marginline: a Vite plugin or Node middleware",
  "keywords": [
    "docx",
    "real-time-collaboration",
    "typescript"
  ],
  "homepage": "https://github.com/mas-ony/office-marginline#readme",
  "bugs": {
    "url": "https://github.com/mas-ony/office-marginline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mas-ony/office-marginline.git",
    "directory": "packages/relay"
  },
  "license": "MIT",
  "author": "Ony Octavianto",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marginline/core": "workspace:*",
    "@types/node": "24.19.1",
    "prosemirror-collab": "1.3.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
